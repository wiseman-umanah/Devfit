# DevFit environment variables
# Copy to .env and fill in values. Never commit .env.

# Required: Groq inference API key
GROQ_API_KEY=your_groq_api_key_here

# Optional: server-side GitHub personal-access token (YOUR token, not the user's)
# DevFit only reads PUBLIC data — this token is purely for rate-limit headroom.
# Without it: 60 unauthenticated requests/hr per server IP (fine for solo dev).
# With it:    5,000 requests/hr — needed once multiple users run concurrently.
# Generate at https://github.com/settings/tokens — zero scopes required.
#
# NOTE: when you later add "connect GitHub account" (OAuth), that is a separate
# per-user token obtained via the GitHub OAuth callback — it never goes here.
GITHUB_TOKEN=

# Optional: database URL
# Leave empty to run without a database (default).
# SQLite:    sqlite+aiosqlite:///./devfit.db
# Postgres:  postgresql+asyncpg://user:pass@localhost/devfit
DATABASE_URL=

# Tunables (optional)
LOG_LEVEL=INFO
DEVFIT_ENV=development

# do not use llama-3, service by Groq was discontinued
GROQ_MODEL=openai/gpt-oss-120b
